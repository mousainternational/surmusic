# Sur Music website — copy this file to .env and fill in real values. Never commit .env.

# Required. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Public address of the site, no trailing slash (canonical URLs, sitemap, email links).
SITE_URL=https://www.example.com
# Domain for automatic HTTPS with docker-compose + Caddy.
DOMAIN=www.example.com

# Database (docker-compose sets this for you).  Examples:
#   postgresql://surmusic:PASSWORD@db:5432/surmusic
#   sqlite:////data/surmusic.db
DATABASE_URL=postgresql://surmusic:change-this-db-password@db:5432/surmusic
POSTGRES_PASSWORD=change-this-db-password

# Uploaded APK / extension / images (must be a persistent volume).
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=200
MAX_IMAGE_MB=5

# Sessions. Cookies are HTTPS-only; set 0 ONLY for local development on http://localhost.
SESSION_COOKIE_SECURE=1
REMEMBER_DAYS=30
ADMIN_SESSION_HOURS=8
# Number of reverse proxies in front of the app (Caddy / Render / Nginx = 1, none = 0).
TRUSTED_PROXIES=1

# Email (password reset, email confirmation, contact form). Any SMTP provider:
# Brevo, Zoho Mail, Mailgun, or a Gmail "app password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Radio Browser station directory
RADIO_CACHE_MINUTES=30
RADIO_TIMEOUT=8
# RADIO_DEMO=1 shows built-in demo stations (testing only — never in production)
RADIO_DEMO=0

# Visitor locations for the admin panel (see README → "Visitor locations").
# Path of the database built by:  flask --app wsgi import-geoip dbip-city-lite-YYYY-MM.csv.gz
GEOIP_DB=/data/storage/geoip.sqlite
# Set to 1 only if the site is behind Cloudflare (uses its CF-IPCountry / CF-IPCity headers).
# Behind Cloudflare + Caddy also set TRUSTED_PROXIES=2.
TRUST_CF_HEADERS=0
# How long analytics are kept (days): page visits / everything else
PAGEVIEW_DAYS=180
EVENT_DAYS=365

# Optional malware scanning of uploaded APK/extension files (docker compose --profile scan up -d)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=0
